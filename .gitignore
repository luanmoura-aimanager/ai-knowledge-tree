# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# iCloud/Finder sync conflict copies (e.g. "foo 2.mdx") — never commit these
* [0-9].mdx
* [0-9].ts
* [0-9].tsx

# Figure generation virtualenv (local authoring only; SVGs are committed)
figures/.venv/
