# AI Knowledge Tree — environment variables.
# Copy to .env.local for local dev, or set in Vercel project settings.
#
# Leave ALL of these unset to run in anonymous-only mode: the dashboard and all
# study pages work; sign-in and progress tracking are simply hidden.

# ---- Database (Neon Postgres, via Vercel Marketplace) --------------------
# Provisioning Neon through the Vercel Marketplace injects this automatically.
# For local dev: copy the Neon connection string (pooled) here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth.js (NextAuth v5) -----------------------------------------------
# Generate a secret with:  npx auth secret    (or: openssl rand -base64 33)
AUTH_SECRET=""

# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI must be:  <origin>/api/auth/callback/google
#   local:      http://localhost:3000/api/auth/callback/google
#   preview:    https://<preview-domain>/api/auth/callback/google
#   production: https://<prod-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auth.js infers the URL on Vercel automatically. Set explicitly only if needed:
# AUTH_URL="https://your-domain.com"
